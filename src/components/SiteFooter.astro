---
interface Props { divider?: boolean }
const { divider = false } = Astro.props;
---
<footer class:list={['wrap', 'site-footer', { divider }]}>
  <span>© 2026 XAN9x</span>
  <a href="/rss.xml">RSS</a>
  <a href="https://github.com/XAN9xXx" target="_blank" rel="noreferrer">GitHub</a>
</footer>
<style>
  .site-footer { display: flex; align-items: center; gap: 32px; flex-wrap: wrap; padding: 28px 0 40px; color: var(--muted); font-size: 14px; }
  .divider { margin-top: var(--s-96); border-top: var(--hairline); }
  a { display: inline-flex; min-height: 44px; align-items: center; color: var(--accent); }
  @media (max-width: 600px) { .divider { margin-top: var(--s-64); } }
</style>
