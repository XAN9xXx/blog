---
import Icon from './Icon.astro';
---
<button class="theme" id="themeToggle" type="button" aria-label="切换主题">
  <span class="sun"><Icon name="sun" size={28} /></span>
  <span class="moon"><Icon name="moon" size={26} /></span>
</button>
<script>
  const button = document.getElementById('themeToggle');
  button?.addEventListener('click', () => {
    const next = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
    document.documentElement.dataset.theme = next;
    try { localStorage.setItem('theme', next); } catch { /* Theme still changes without storage. */ }
  });
</script>
<style>
  .theme { display: inline-flex; align-items: center; justify-content: center; min-width: 60px; min-height: 44px; padding: 4px 0 4px 24px; border: 0; border-left: var(--hairline); background: none; cursor: pointer; }
  .theme:hover { color: var(--accent); }
  .sun { display: none; }
  .moon { display: inline-flex; }
  :global([data-theme="dark"]) .sun { display: inline-flex; }
  :global([data-theme="dark"]) .moon { display: none; }
  @media (max-width: 600px) { .theme { padding-left: 12px; min-width: 44px; } }
</style>
