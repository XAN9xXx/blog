---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  /** Pages that must not be indexed (the 404 page) get no canonical address. */
  noindex?: boolean;
}

const {
  title = 'XAN9x',
  description = 'Software, systems, open source and technical notes.',
  noindex = false,
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />

    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, viewport-fit=cover"
    />

    <meta
      name="description"
      content={description}
    />

    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical.href} />}

    <link rel="alternate" type="application/rss+xml" title="XAN9x" href="/rss.xml" />

    <script is:inline>
      (function () {
        var d = document.documentElement;

        try {
          var t = localStorage.getItem('theme');

          if (t !== 'light' && t !== 'dark') {
            t = 'dark';
          }

          d.dataset.theme = t;
        } catch (e) {
          d.dataset.theme = 'dark';
        }
      })();
    </script>

    <title>{title}</title>
  </head>

  <body>
    <a class="skip-link" href="#main">
      跳到主要内容
    </a>

    <slot />
  </body>
</html>
