---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'XAN9x',
  description = 'Software, systems, open source and technical notes.',
} = Astro.props;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />

    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, viewport-fit=cover"
    />

    <meta
      name="description"
      content={description}
    />

    <script is:inline>
      (function () {
        var d = document.documentElement;

        try {
          var t = localStorage.getItem('theme');

          if (t !== 'light' && t !== 'dark') {
            t = matchMedia(
              '(prefers-color-scheme: dark)'
            ).matches
              ? 'dark'
              : 'light';
          }

          d.dataset.theme = t;
        } catch (e) {
          d.dataset.theme = 'light';
        }
      })();
    </script>

    <title>{title}</title>
  </head>

  <body>
    <a class="skip-link" href="#main">
      跳到主要内容
    </a>

    <slot />
  </body>
</html>
