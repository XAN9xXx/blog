# 阿里云 VPS + SSH 本地转发：复制到仓库外的私有配置文件。
# ORIGIN 是本机浏览器使用的地址；即使服务部署在 VPS 上，也填本机转发地址。
WORKBENCH_ORIGIN=http://127.0.0.1:4325
# PORT 是 VPS 上的监听端口，可以与本机转发端口不同。
WORKBENCH_PORT=4325
WORKBENCH_CONTENT_DIR=/srv/worktrees/xan9x-blog-content
WORKBENCH_STATE_DIR=/var/lib/xan9x-workbench
# 用 npm run workbench:password --silent 生成。不要填明文密码。
WORKBENCH_PASSWORD_HASH=REPLACE_WITH_SCRYPT_HASH
